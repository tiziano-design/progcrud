@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap');

/* Fondo general moderno */
body {
  font-family: 'Montserrat', sans-serif;
  background: linear-gradient(135deg, #13151a 0%, #1e222d 100%);
  color: #ffffff;
  margin: 0;
  padding: 40px 20px;
  min-height: 100vh;
}

.container {
  max-width: 960px;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  padding: 30px 35px;
  border-radius: 18px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

h1 {
  text-align: center;
  color: #00ff88;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 28px;
  font-weight: 700;
  text-shadow: 0 0 14px rgba(0, 255, 136, 0.36);
}

.dashboard-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.card {
  padding: 20px 22px;
  border-radius: 16px;
  background: rgba(0, 0, 0, 0.28);
  border: 1px solid rgba(0, 255, 136, 0.18);
  box-shadow: 0 12px 30px rgba(0, 255, 136, 0.08);
}

.card span {
  display: block;
  color: #a5ffcd;
  font-size: 12px;
  letter-spacing: 1px;
  margin-bottom: 10px;
  text-transform: uppercase;
}

.card strong {
  display: block;
  font-size: 2.1rem;
  color: #ffffff;
}

.search-container {
  margin-bottom: 24px;
}

.search-container input {
  width: 100%;
  padding: 16px 18px;
  border-radius: 14px;
  border: 1px solid rgba(0, 255, 136, 0.22);
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  outline: none;
  font-size: 15px;
  transition: all 0.25s ease;
}

.search-container input:focus {
  border-color: #00ff88;
  box-shadow: 0 0 20px rgba(0, 255, 136, 0.2);
}

#socioForm {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 34px;
  padding: 24px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.form-group {
  display: flex;
  gap: 14px;
}

.form-group input,
.form-group select {
  flex: 1;
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  color: white;
  font-size: 14px;
  outline: none;
  transition: all 0.3s ease;
}

.form-group input::placeholder {
  color: #999;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #00ff88;
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 12px rgba(0, 255, 136, 0.18);
}

.form-group select option {
  background: #1e222d;
  color: white;
}

button {
  padding: 14px 22px;
  background: #00ff88;
  color: #000;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s ease;
}

button:hover {
  background: #00cc6a;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 255, 136, 0.35);
}

#btnCancelar {
  background: #ff4757;
  color: white;
}

#btnCancelar:hover {
  background: #ff6b81;
}

.hidden {
  display: none !important;
}

table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 10px;
  margin-top: 18px;
}

th,
td {
  padding: 16px;
  text-align: left;
}

th {
  color: #00ff88;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 13px;
  letter-spacing: 1px;
  border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

td {
  background: rgba(0, 0, 0, 0.28);
  color: #ddd;
}

tr td:first-child {
  border-top-left-radius: 10px;
  border-bottom-left-radius: 10px;
}

tr td:last-child {
  border-top-right-radius: 10px;
  border-bottom-right-radius: 10px;
}

tr:hover td {
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
}

.btn-editar,
.btn-eliminar,
.btn-estado {
  padding: 8px 12px;
  font-size: 12px;
  border-radius: 7px;
  margin-right: 6px;
  text-transform: none;
  font-weight: 700;
}

.btn-editar {
  background: #feca57;
  color: #000;
}

.btn-editar:hover {
  background: #ffb347;
}

.btn-eliminar {
  background: #ff4757;
  color: white;
}

.btn-eliminar:hover {
  background: #ff6b81;
}

.btn-estado {
  background: #1e90ff;
  color: white;
}

.btn-estado:hover {
  background: #4b8cff;
}
